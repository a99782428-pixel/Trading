rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'a99782428@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == userId &&
        incoming().role == 'user'; // Prevent privilege escalation

      allow update: if (isOwner(userId) &&
        incoming().uid == existing().uid &&
        incoming().role == existing().role &&
        incoming().liveBalance == existing().liveBalance) || isAdmin();

      // Nested questionnaire
      match /questionnaire/{responseId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Payment methods for deposits
    match /paymentMethods/{methodId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Deposit requests
    match /depositRequests/{requestId} {
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Withdrawal requests
    match /withdrawalRequests/{requestId} {
      allow get, list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
