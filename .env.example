# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OWNER_DEPOSIT_EDIT_CODE: Passcode for the owner-only deposit method editor.
# Development default value: 123123123123
# In production, replace with a secure secret.
OWNER_DEPOSIT_EDIT_CODE="123123123123"

# PORT: Server port (3000)
PORT=3000
